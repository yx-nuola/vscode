{
  "name": "my-extension",
  "displayName": "my-extension",
  "description": "RRAM 数据可视化 VS Code 插件",
  "version": "0.0.1",
  "publisher": "local",
  "engines": {
    "vscode": "^1.103.1"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onCommand:my-extension.helloWorld",
    "onCommand:my-extension.openBitmapEditor",
    "onView:my-extension.dataPanel"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "my-extension.helloWorld",
        "title": "My Extension: Hello World"
      },
      {
        "command": "my-extension.openDataPanel",
        "title": "打开数据面板"
      },
      {
        "command": "my-extension.openBitmapEditor",
        "title": "Open RRAM Bitmap Editor"
      }
    ],
    "viewsContainers": {
      "panel": [
        {
          "id": "my-extension-panel",
          "title": "数据面板",
          "icon": "resources/table.svg"
        }
      ]
    },
    "views": {
      "my-extension-panel": [
        {
          "type": "webview",
          "id": "my-extension.dataPanel",
          "name": "数据表格",
          "icon": "$(table)"
        }
      ]
    },
    "menus": {}
  },
  "scripts": {
    "vscode:prepublish": "npm run build:prod",
    "dev": "npm-run-all -p watch:esbuild watch:tsc watch:webview",
    "dev:f5": "npm run build:webview && npm-run-all -p watch:esbuild watch:tsc watch:webview",
    "watch": "npm-run-all -p watch:esbuild watch:tsc",
    "watch:esbuild": "node esbuild.js --watch",
    "watch:tsc": "tsc --noEmit --watch --project tsconfig.json",
    "watch:webview": "vite build --config src/webview/vite.config.mts --watch",
    "build": "npm run build:extension && npm run build:webview",
    "build:prod": "npm run build:extension && npm run build:webview",
    "build:extension": "npm run check-types && npm run lint && node esbuild.js --production",
    "build:webview": "vite build --config src/webview/vite.config.mts",
    "package:vsix": "vsce package --no-dependencies --allow-missing-repository",
    "package:vsix:install": "npm run package:vsix && code --install-extension my-extension-0.0.1.vsix",
    "compile": "npm run check-types && npm run lint && node esbuild.js",
    "package": "npm run build:extension",
    "compile-tests": "tsc -p . --outDir out",
    "watch-tests": "tsc -p . -w --outDir out",
    "pretest": "npm run validate && npm run compile-tests && npm run compile",
    "validate": "npm run validate:json && npm run format:check && npm run check-types && npm run lint",
    "validate:json": "node scripts/validate-formats.mjs",
    "format": "prettier --write \"src/**/*.{ts,tsx,js,mjs,css,scss,json}\" \"scripts/**/*.mjs\" \"*.{json,js,mjs}\" \".vscode/**/*.json\" \"esbuild.js\" \"eslint.config.mjs\"",
    "format:check": "prettier --check \"src/**/*.{ts,tsx,js,mjs,css,scss,json}\" \"scripts/**/*.mjs\" \"*.{json,js,mjs}\" \".vscode/**/*.json\" \"esbuild.js\" \"eslint.config.mjs\"",
    "check-types": "tsc --noEmit && npm run check-types:bitmap && npm run check-types:line-chart",
    "check-types:bitmap": "tsc --noEmit -p src/webview/tsconfig.bitmap.json",
    "check-types:line-chart": "tsc --noEmit -p src/webview/tsconfig.line-chart.json",
    "lint": "eslint src",
    "test": "vscode-test"
  },
  "devDependencies": {
    "@types/mocha": "^10.0.10",
    "@types/node": "22.x",
    "@types/papaparse": "^5.5.2",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@types/vscode": "^1.103.1",
    "@vitejs/plugin-react": "^5.1.4",
    "@vscode/test-cli": "^0.0.12",
    "@vscode/test-electron": "^2.5.2",
    "@vscode/vsce": "^3.7.1",
    "esbuild": "^0.27.1",
    "eslint": "^9.39.1",
    "jsdom": "^28.1.0",
    "npm-run-all": "^4.1.5",
    "prettier": "^3.9.6",
    "sass": "^1.102.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.48.1",
    "vite": "^7.3.1",
    "vitest": "^4.0.18"
  },
  "dependencies": {
    "@arco-design/web-react": "^2.66.10",
    "@visactor/vtable": "^1.26.0",
    "ahooks": "^3.9.7",
    "echarts": "^5.5.1",
    "konva": "^10.2.5",
    "lru-cache": "^11.0.0",
    "mitt": "^3.0.1",
    "papaparse": "^5.5.4",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "react-router-dom": "^7.15.1",
    "vscode-messenger": "^0.6.1",
    "vscode-messenger-common": "^0.6.1",
    "vscode-messenger-webview": "^0.6.1"
  }
}
